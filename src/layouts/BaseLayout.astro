---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import JsonLd from '../components/JsonLd.astro';
import { brand, theme } from '../lib/brand';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  publishDate?: Date;
  updatedDate?: Date;
  author?: string;
}

const { title, description, jsonLd, publishDate, updatedDate, author } = Astro.props;

const ORG = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: brand.name,
  url: Astro.site?.toString(),
  description: brand.description,
  ...(brand.areaServed ? { areaServed: brand.areaServed } : {}),
};

const pageSchemas = Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [];
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const themeVars = `:root{--bg:${theme.bg};--surface:${theme.surface};--surface-raised:${theme.surfaceRaised};--ink:${theme.ink};--ink-muted:${theme.inkMuted};--gold:${theme.gold};--gold-soft:${theme.goldSoft};--cherry:${theme.cherry};--line:${theme.line}}`;
---

<!doctype html>
<html lang={brand.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} · {brand.name}</title>
    <meta name="description" content={description} />
    <style set:html={themeVars} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Sinais de autoria/data — usados por motores de resposta como sinal de confiabilidade (E-E-A-T) -->
    {author && <meta name="author" content={author} />}
    {publishDate && <meta name="article:published_time" content={publishDate.toISOString()} />}
    {updatedDate && <meta name="article:modified_time" content={updatedDate.toISOString()} />}

    <!-- Aponta explicitamente para o resumo estruturado do site, pensado para agentes/LLMs -->
    <link rel="llms-txt" href="/llms.txt" />

    <JsonLd data={ORG} />
    {pageSchemas.map((schema) => <JsonLd data={schema} />)}
  </head>
  <body>
    <Header />
    <main class="wrap">
      <slot />
    </main>
    <Footer />
  </body>
</html>
