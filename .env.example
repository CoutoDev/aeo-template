# Identidade e tema da marca desta instância. Site 100% estático — estas
# variáveis precisam existir em BUILD TIME (npm run build / docker build),
# não só em runtime. Nenhum valor aqui é secreto: é conteúdo público que
# vai parar no HTML gerado.

# --- Obrigatórias ---
SITE_NAME="Nome da Marca"
SITE_URL="https://minhamarca.example.com"
SITE_DESCRIPTION="Descrição curta da marca (1-2 frases), usada no schema.org Organization e no llms.txt."

# --- Opcionais ---
SITE_LOCATION="Cidade, UF"
SITE_LOCALE="pt-BR"
SITE_AREA_SERVED=""

# Paleta de cores (custom properties CSS). Se omitidas, usa um tema escuro
# neutro como fallback (ver defaults em src/lib/brand.ts).
THEME_BG="#1c1512"
THEME_SURFACE="#251c17"
THEME_SURFACE_RAISED="#2f231d"
THEME_INK="#ede6dd"
THEME_INK_MUTED="#b3a294"
THEME_GOLD="#c9a54a"
THEME_GOLD_SOFT="#e4c877"
THEME_CHERRY="#8b3a2e"
THEME_LINE="#3c2f27"

# Portas do docker-compose.yml — únicas por instância se você rodar várias
# marcas no mesmo host ao mesmo tempo.
DEV_PORT=4321
WEB_PORT=8080
