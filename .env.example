# Identidade e tema da marca desta instância. Site 100% estático — estas
# variáveis precisam existir em BUILD TIME (npm run build / docker build),
# não só em runtime. Nenhum valor aqui é secreto: é conteúdo público que
# vai parar no HTML gerado.

# --- Obrigatórias ---
SITE_NAME="Nome da Marca"
SITE_URL="https://minhamarca.example.com"
SITE_DESCRIPTION="Descrição curta da marca (1-2 frases), usada no schema.org Organization e no llms.txt."

# --- Opcionais ---
SITE_LOCATION="Cidade, UF"
SITE_LOCALE="pt-BR"
SITE_AREA_SERVED=""

# Paleta de cores (custom properties CSS). Se omitidas, usa um tema escuro
# neutro como fallback (ver defaults em src/lib/brand.ts).
THEME_BG="#1c1512"
THEME_SURFACE="#251c17"
THEME_SURFACE_RAISED="#2f231d"
THEME_INK="#ede6dd"
THEME_INK_MUTED="#b3a294"
THEME_GOLD="#c9a54a"
THEME_GOLD_SOFT="#e4c877"
THEME_CHERRY="#8b3a2e"
THEME_LINE="#3c2f27"

# Tipografia. THEME_FONT_IMPORT_URL precisa apontar pra uma folha de estilo
# (ex: Google Fonts) que já contenha as famílias usadas em THEME_FONT_*, ou
# elas caem no fallback do sistema. THEME_TYPE_SCALE escala TODO o texto do
# site de uma vez (relativo, 1 = tamanho padrão do template).
THEME_FONT_DISPLAY="'Fraunces', Georgia, serif"
THEME_FONT_BODY="'Inter', system-ui, sans-serif"
THEME_FONT_MONO="'JetBrains Mono', ui-monospace, monospace"
THEME_FONT_IMPORT_URL="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
THEME_TYPE_SCALE="1"

# Escala de espaçamento. Os degraus nomeados (--space-xs ... --space-3xl,
# usados pelos componentes) são derivados destes dois valores — ver
# src/styles/global.css. THEME_SPACE_RATIO maior = mais "ar" entre os
# elementos conforme a escala sobe.
THEME_SPACE_UNIT="1rem"
THEME_SPACE_RATIO="1.5"

# Bordas.
THEME_RADIUS="2px"
THEME_ACCENT_BORDER_WIDTH="3px"

# Portas do docker-compose.yml — únicas por instância se você rodar várias
# marcas no mesmo host ao mesmo tempo.
DEV_PORT=4321
WEB_PORT=8080
