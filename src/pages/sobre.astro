---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getEntry, render } from 'astro:content';

const about = await getEntry('pages', 'about');
const { Content } = await render(about);
---

<BaseLayout title={about.data.title} description={about.data.metaDescription}>
  <section class="section">
    {about.data.eyebrow && <p class="eyebrow">{about.data.eyebrow}</p>}
    <h1 class="section__title">{about.data.heading ?? about.data.title}</h1>
    <div class="prose">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding: 3rem 0 4rem; max-width: 42rem; }
  .section__title { font-size: 1.9rem; margin: 0.4rem 0 1.5rem; }
  .prose p { color: var(--ink-muted); }
</style>
