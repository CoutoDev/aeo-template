---
// Cada bloco responde UMA pergunta de forma autocontida: a resposta
// direta (1-3 frases) fica isolada visualmente, como o texto de um
// rótulo de saca — é o trecho que agentes de IA tendem a extrair e citar.
// A elaboração abaixo é o material de aprofundamento, para leitores humanos e SEO.
interface Props {
  question: string;
  shortAnswer: string;
  index?: number;
  id?: string;
}
const { question, shortAnswer, index, id } = Astro.props;
---

<article class="answer-block" id={id}>
  <div class="tag">
    {index !== undefined && <span class="tag__num">{String(index).padStart(2, '0')}</span>}
    <span class="tag__label">Pergunta</span>
  </div>
  <h3 class="answer-block__q">{question}</h3>
  <p class="answer-block__a"><strong>{shortAnswer}</strong></p>
  <div class="answer-block__body">
    <slot />
  </div>
</article>

<style>
  .answer-block {
    background: var(--surface);
    border: 1px solid var(--line);
    border-left: var(--accent-border-width) solid var(--gold);
    border-radius: var(--radius);
    padding: var(--space-lg);
  }
  .tag {
    display: flex;
    align-items: baseline;
    gap: var(--space-sm);
    margin-bottom: var(--space-sm);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .tag__num {
    color: var(--gold);
    font-size: 0.8rem;
  }
  .answer-block__q {
    font-size: 1.2rem;
    margin-bottom: var(--space-sm);
  }
  .answer-block__a {
    margin: 0 0 var(--space-md);
    color: var(--ink);
  }
  .answer-block__body {
    color: var(--ink-muted);
    font-size: 0.95rem;
  }
  .answer-block__body :global(p) {
    margin: var(--space-xs) 0;
  }
</style>
