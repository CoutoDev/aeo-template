---
// Ferramenta só de dev: sobrepõe os tokens de tema com um dos presets do
// design system, em tempo real, sem tocar no .env desta instância. Só é
// importado/renderizado quando import.meta.env.DEV (ver Header.astro) —
// nunca deve aparecer/rodar num build de produção.
import { BRAND_PRESETS } from '../lib/brand-presets';
import { brand } from '../lib/brand';
---

<div class="brand-preset-switcher">
  <label for="brand-preset-select">Design system</label>
  <select id="brand-preset-select" data-brand-preset-select>
    <option value="">{brand.name} (atual)</option>
    {BRAND_PRESETS.map((preset) => <option value={preset.key}>{preset.name}</option>)}
  </select>
</div>

<!-- set:html força o script a ser is:inline (sem processamento/import) — por
     isso os dados ficam num data island separado e o <script> abaixo, sem
     set:html, continua sendo processado pelo Vite e pode importar módulos
     (ver mesma técnica em JsonLd.astro). -->
<script type="application/json" id="brand-presets-data" set:html={JSON.stringify(BRAND_PRESETS)} />

<style>
  .brand-preset-switcher {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.78rem;
    color: var(--ink-muted);
  }
  .brand-preset-switcher select {
    font: inherit;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: 0.2rem 0.4rem;
  }
</style>

<script>
  import { modeVars } from '../lib/theme-css';
  import type { BrandPreset } from '../lib/brand-presets';

  const STYLE_ID = 'brand-preset-override';
  const STORAGE_KEY = 'devBrandPreset';

  const dataEl = document.getElementById('brand-presets-data');
  const presets: BrandPreset[] = dataEl ? JSON.parse(dataEl.textContent || '[]') : [];

  const findPreset = (key: string) => presets.find((preset) => preset.key === key);

  // localStorage pode lançar (modo privado, cookies bloqueados) — a escolha do
  // preset é conveniência de dev, então falha em silêncio.
  const rememberedPreset = (): string => {
    try { return localStorage.getItem(STORAGE_KEY) || ''; } catch { return ''; }
  };
  const rememberPreset = (key: string) => {
    try {
      if (key) localStorage.setItem(STORAGE_KEY, key);
      else localStorage.removeItem(STORAGE_KEY);
    } catch {}
  };

  function ensureFontLoaded(url?: string) {
    if (!url || document.querySelector(`link[href="${url}"]`)) return;
    const link = document.createElement('link');
    link.rel = 'stylesheet';
    link.href = url;
    document.head.appendChild(link);
  }

  function overrideCss(preset: BrandPreset): string {
    return [
      `:root{--font-display:${preset.fontDisplay};--radius:${preset.radius};`,
      `--accent-border-width:${preset.accentBorderWidth};--space-ratio:${preset.spaceRatio}}`,
      `[data-theme="dark"]{${modeVars(preset.dark)}}`,
      `[data-theme="light"]{${modeVars(preset.light)}}`,
    ].join('');
  }

  /** Chave vazia = voltar para a marca desta instância (remove o override). */
  function applyPreset(key: string) {
    let styleEl = document.getElementById(STYLE_ID);
    if (!key) {
      styleEl?.remove();
      rememberPreset('');
      return;
    }
    const preset = findPreset(key);
    if (!preset) return;

    ensureFontLoaded(preset.fontImportUrl);
    if (!styleEl) {
      styleEl = document.createElement('style');
      styleEl.id = STYLE_ID;
      document.head.appendChild(styleEl);
    }
    // Anexado depois do <style> de tokens do BaseLayout — mesma
    // especificidade, ordem de origem decide, sem precisar de !important.
    styleEl.textContent = overrideCss(preset);
    rememberPreset(key);
  }

  document.querySelectorAll<HTMLSelectElement>('[data-brand-preset-select]').forEach((select) => {
    const remembered = rememberedPreset();
    if (remembered && findPreset(remembered)) {
      select.value = remembered;
      applyPreset(remembered);
    }
    select.addEventListener('change', (event) =>
      applyPreset((event.target as HTMLSelectElement).value)
    );
  });
</script>
