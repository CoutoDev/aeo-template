---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { brand } from '../../lib/brand';
import { getRequiredPage } from '../../lib/content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const page = await getRequiredPage('jornal');
---

<BaseLayout title={page.data.title} description={page.data.metaDescription}>
  <section class="section">
    <p class="eyebrow">{page.data.title}</p>
    <h1 class="section__title">{page.data.heading ?? page.data.title}</h1>
    <div class="post-list">
      {posts.map((p) => (
        <a class="post-row" href={`/jornal/${p.id}`}>
          <span class="eyebrow">{p.data.publishDate.toLocaleDateString(brand.locale, { day: '2-digit', month: 'short', year: 'numeric' })}</span>
          <h2>{p.data.title}</h2>
          <p>{p.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding: var(--space-2xl) 0 var(--space-2xl); max-width: 42rem; }
  .section__title { font-size: 1.9rem; margin: var(--space-xs) 0 var(--space-xl); }
  .post-list { display: grid; gap: var(--space-xl); }
  .post-row { text-decoration: none; display: block; padding-bottom: var(--space-xl); border-bottom: 1px solid var(--line); }
  .post-row h2 { color: var(--ink); font-size: 1.3rem; margin: var(--space-xs) 0 var(--space-xs); }
  .post-row p { color: var(--ink-muted); margin: 0; }
</style>
