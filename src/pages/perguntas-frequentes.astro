---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import { render } from 'astro:content';
import { getFaqsInOrder, getRequiredPage } from '../lib/content';
import { faqPageSchema } from '../lib/schema';

const faqs = await getFaqsInOrder();
// O corpo Markdown de cada FAQ (a elaboração abaixo da resposta curta) precisa
// ser renderizado fora do JSX — daí o par ordenado faq/componente.
const faqSections = await Promise.all(
  faqs.map(async (faq) => ({ faq, Body: (await render(faq)).Content }))
);
const page = await getRequiredPage('faq');
---

<BaseLayout
  title={page.data.title}
  description={page.data.metaDescription}
  jsonLd={faqPageSchema(faqs)}
>
  <section class="section">
    <p class="eyebrow">{page.data.title}</p>
    <h1 class="section__title">{page.data.heading ?? page.data.title}</h1>
    <div class="answer-list">
      {faqSections.map(({ faq, Body }, index) => (
        <AnswerBlock
          question={faq.data.question}
          shortAnswer={faq.data.shortAnswer}
          index={index + 1}
          id={faq.id}
        >
          <Body />
        </AnswerBlock>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding: var(--space-2xl) 0 var(--space-2xl); }
  .section__title { font-size: 1.9rem; margin: var(--space-xs) 0 var(--space-xl); }
  .answer-list { display: grid; gap: var(--space-md); max-width: 42rem; }
</style>
