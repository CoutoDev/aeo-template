---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { formatLongDate } from '../../lib/date';
import { articleSchema } from '../../lib/schema';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, publishDate, author, cover, coverAlt, updatedDate } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  jsonLd={articleSchema(post, Astro.site)}
  publishDate={publishDate}
  updatedDate={updatedDate}
  author={author}
>
  <article class="post section">
    <p class="eyebrow">
      {formatLongDate(publishDate)}
      · {author}
    </p>
    <h1 class="post__title">{title}</h1>
    <p class="post__lede">{description}</p>
    {cover && (
      <Image
        class="post__cover"
        src={cover}
        alt={coverAlt ?? title}
        widths={[600, 1200]}
        sizes="42rem"
        format="webp"
      />
    )}
    <div class="prose">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .section { padding: var(--space-2xl) 0 var(--space-2xl); max-width: 42rem; }
  .post__title { font-size: 2rem; margin: var(--space-xs) 0 var(--space-md); }
  .post__lede { color: var(--ink-muted); font-size: 1.05rem; }
  .post__cover { display: block; width: 100%; height: auto; max-height: 24rem; object-fit: cover; border-radius: var(--radius); margin-top: var(--space-lg); }
  .prose :global(h2) { font-size: 1.3rem; margin-top: var(--space-xl); }
  .prose :global(p) { color: var(--ink-muted); }
</style>
