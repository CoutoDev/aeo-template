---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { brand } from '../../lib/brand';
import { getRequiredPage } from '../../lib/content';

const posts = (await getCollection('posts')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const page = await getRequiredPage('jornal');
---

<BaseLayout title={page.data.title} description={page.data.metaDescription}>
  <section class="section">
    <p class="eyebrow">{page.data.title}</p>
    <h1 class="section__title">{page.data.heading ?? page.data.title}</h1>
    <div class="post-list">
      {posts.map((p) => (
        <a class="post-row" href={`/jornal/${p.id}`}>
          {p.data.cover && (
            <Image
              class="post-row__thumb"
              src={p.data.cover}
              alt={p.data.coverAlt ?? p.data.title}
              widths={[200, 400]}
              sizes="8rem"
              format="webp"
            />
          )}
          <div class="post-row__body">
            <span class="eyebrow">{p.data.publishDate.toLocaleDateString(brand.locale, { day: '2-digit', month: 'short', year: 'numeric' })}</span>
            <h2>{p.data.title}</h2>
            <p>{p.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .section { padding: var(--space-2xl) 0 var(--space-2xl); max-width: 42rem; }
  .section__title { font-size: 1.9rem; margin: var(--space-xs) 0 var(--space-xl); }
  .post-list { display: grid; gap: var(--space-xl); }
  .post-row { text-decoration: none; display: flex; gap: var(--space-md); align-items: flex-start; padding-bottom: var(--space-xl); border-bottom: 1px solid var(--line); }
  .post-row__thumb { flex: none; width: 8rem; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius); }
  .post-row__body { min-width: 0; }
  .post-row h2 { color: var(--ink); font-size: 1.3rem; margin: var(--space-xs) 0 var(--space-xs); }
  .post-row p { color: var(--ink-muted); margin: 0; }
</style>
