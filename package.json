{
  "name": "brand-engine",
  "type": "module",
  "version": "0.5.2",
  "description": "Template Astro agnóstico de marca (AEO/SEO), empacotado como imagem Docker única que clona e serve o conteúdo de uma marca em runtime.",
  "files": [
    "src",
    "public",
    "scripts",
    "templates",
    "tina",
    "traefik",
    "astro.config.mjs",
    "tsconfig.json",
    "Dockerfile",
    "entrypoint.sh",
    "docker-compose.yml",
    "docker-compose.example.yml",
    "nginx.conf",
    ".dockerignore",
    ".env.example"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-example-content.mjs",
    "dev": "astro dev",
    "check": "astro check",
    "check:theme": "node scripts/check-theme-leak.mjs",
    "llms-txt": "node scripts/generate-llms-txt.mjs",
    "prebuild": "node scripts/ensure-example-content.mjs && npm run llms-txt",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "tina:build": "TINA_PUBLIC_IS_LOCAL=true tinacms build --skip-indexing --skip-cloud-checks --skip-search-index",
    "tina:server": "tsx tina/server.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@tinacms/cli": "^2.5.6",
    "@tinacms/datalayer": "^2.0.29",
    "@tinacms/graphql": "^2.4.9",
    "astro": "^7.1.3",
    "gray-matter": "^4.0.3",
    "sqlite-level": "^2.1.1",
    "tinacms": "^3.11.0",
    "tinacms-gitprovider-github": "^4.1.16",
    "tsx": "^4.23.1",
    "vite": "^8.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "typescript": "^6.0.3"
  }
}
