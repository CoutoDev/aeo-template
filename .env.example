# Identidade e tema da marca desta instância. O build real (npm run build)
# roda dentro do container no boot (ver entrypoint.sh), lendo essas
# variáveis do ambiente do processo — não em build-time da imagem. Nenhum
# valor aqui é secreto: é conteúdo público que vai parar no HTML gerado.

# --- Obrigatórias ---
SITE_NAME="Nome da Marca"
SITE_URL="https://minhamarca.example.com"
SITE_DESCRIPTION="Descrição curta da marca (1-2 frases), usada no schema.org Organization e no llms.txt."

# --- Opcionais ---
SITE_LOCATION="Cidade, UF"
SITE_LOCALE="pt-BR"
SITE_AREA_SERVED=""

# --- Tema ---
# Sem nenhuma THEME_* definida, o site sai com o preset padrão do template (o
# primeiro de src/lib/brand-presets.ts). Descomente abaixo só o que esta marca
# precisa mudar — cada token não definido continua vindo do preset.

# Modo inicial. O visitante troca no botão do header (respeitando
# prefers-color-scheme e a última escolha em localStorage); isto aqui só
# decide o modo usado antes do JS rodar / quando não há preferência salva.
#THEME_DEFAULT_MODE="dark"

# Paleta de cores (custom properties CSS) — um valor pra cada modo. Qualquer
# cor CSS serve (os presets usam oklch); valores hex precisam de aspas
# ("#112233"), senão o "#" vira comentário e o valor é truncado.
#THEME_BG_DARK=
#THEME_BG_LIGHT=
#THEME_SURFACE_DARK=
#THEME_SURFACE_LIGHT=
#THEME_SURFACE_RAISED_DARK=
#THEME_SURFACE_RAISED_LIGHT=
#THEME_INK_DARK=
#THEME_INK_LIGHT=
#THEME_INK_MUTED_DARK=
#THEME_INK_MUTED_LIGHT=
#THEME_ACCENT_DARK=
#THEME_ACCENT_LIGHT=
#THEME_ACCENT_SOFT_DARK=
#THEME_ACCENT_SOFT_LIGHT=
#THEME_ACCENT_2_DARK=
#THEME_ACCENT_2_LIGHT=
#THEME_LINE_DARK=
#THEME_LINE_LIGHT=

# Tipografia. THEME_FONT_IMPORT_URL precisa apontar pra uma folha de estilo
# (ex: Google Fonts) que já contenha as famílias usadas em THEME_FONT_*, ou
# elas caem no fallback do sistema. THEME_TYPE_SCALE escala TODO o texto do
# site de uma vez (relativo, 1 = tamanho padrão do template).
#THEME_FONT_DISPLAY=
#THEME_FONT_BODY=
#THEME_FONT_MONO=
#THEME_FONT_IMPORT_URL=
#THEME_TYPE_SCALE=

# Escala de espaçamento. Os degraus nomeados (--space-xs ... --space-3xl,
# usados pelos componentes) são derivados destes dois valores — ver
# src/styles/global.css. THEME_SPACE_RATIO maior = mais "ar" entre os
# elementos conforme a escala sobe.
#THEME_SPACE_UNIT=
#THEME_SPACE_RATIO=

# Bordas.
#THEME_RADIUS=
#THEME_ACCENT_BORDER_WIDTH=

# Portas do docker-compose.yml — únicas por instância se você rodar várias
# marcas no mesmo host ao mesmo tempo.
DEV_PORT=4321
WEB_PORT=8080

# Proxy compartilhado (Traefik) — só relevante rodando múltiplas marcas na
# mesma VPS atrás de um domínio próprio cada. Ver traefik/README.md no
# template. DOMAIN é o domínio público desta marca (registro DNS A apontando
# pra VPS); BRAND_SLUG precisa ser único entre as marcas que compartilham a
# mesma VPS/Traefik (o CLI já gera um a partir do nome da marca).
DOMAIN="minhamarca.example.com"
BRAND_SLUG="minha-marca"

# --- Conteúdo da marca (imagem brand-engine) ---
# Repositório GitHub com o conteúdo desta marca (src/content/**). Clonado
# pelo entrypoint.sh a cada boot do container — ver README.
CONTENT_REPO_URL="https://github.com/minha-org/minha-marca-conteudo.git"

# Token do GitHub com escopo restrito a ESTE repositório (fine-grained
# Personal Access Token ou deploy key com permissão de leitura+escrita em
# "Contents") — nunca um token amplo de organização. Segredo de verdade:
# nunca commitar num .env versionado. Obrigatório mesmo só pra leitura,
# porque o backend do Tina (tina/database.ts) sempre configura o git
# provider, mesmo antes de qualquer escrita acontecer.
CONTENT_REPO_TOKEN=""

# Branch do repositório de conteúdo usada pelo git provider do Tina.
#CONTENT_REPO_BRANCH="main"

# --- Backend do Tina (self-hosted, ver tina/) ---
# Usuário e hash da senha de acesso ao /admin desta marca — auth simples e
# própria, sem Tina Cloud. Gere o hash com:
#   node scripts/hash-tina-password.mjs "sua-senha"
TINA_ADMIN_USER="admin"
TINA_ADMIN_PASSWORD_HASH=""

# Porta do docker-compose.yml pro backend do Tina (acesso direto, sem
# Traefik — ver README).
TINA_PORT=4001
