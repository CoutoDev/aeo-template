---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerBlock from '../components/AnswerBlock.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import { getFaqsInOrder, getPostsNewestFirst, getRequiredPage } from '../lib/content';
import { formatShortDate } from '../lib/date';
import { faqPageSchema } from '../lib/schema';

// A home mostra só uma prévia do FAQ; a lista completa vive em
// /perguntas-frequentes.
const FEATURED_FAQ_COUNT = 3;

const featuredFaqs = (await getFaqsInOrder()).slice(0, FEATURED_FAQ_COUNT);
const posts = await getPostsNewestFirst();

const home = await getRequiredPage('home');
const { Content: HomeLede } = await render(home);
const { eyebrow, title, metaDescription, hero, heroAlt, specs } = home.data;
---

<BaseLayout title={title} description={metaDescription} jsonLd={faqPageSchema(featuredFaqs)}>
  <section class="hero">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h1>{title}</h1>
    <div class="hero__lede"><HomeLede /></div>
    {hero && (
      <Image
        class="hero__image"
        src={hero}
        alt={heroAlt ?? title}
        widths={[800, 1600]}
        sizes="(min-width: 768px) 42rem, 100vw"
        format="webp"
      />
    )}
    {specs && (
      <div class="hero__specs">
        {specs.map((spec) => (
          <div><span class="eyebrow">{spec.label}</span><strong>{spec.value}</strong></div>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <p class="eyebrow">Perguntas mais frequentes</p>
    <h2 class="section__title">Antes de pedir, as dúvidas que mais chegam</h2>
    <div class="answer-grid">
      {featuredFaqs.map((faq, index) => (
        <AnswerBlock
          question={faq.data.question}
          shortAnswer={faq.data.shortAnswer}
          index={index + 1}
        />
      ))}
    </div>
    <a class="see-all" href="/perguntas-frequentes">Ver todas as perguntas →</a>
  </section>

  <section class="section">
    <p class="eyebrow">Jornal da torra</p>
    <h2 class="section__title">Guias sobre origem, torra e preparo</h2>
    <div class="post-grid">
      {posts.map((post) => (
        <a class="post-card" href={`/jornal/${post.id}`}>
          {post.data.cover && (
            <Image
              class="post-card__thumb"
              src={post.data.cover}
              alt={post.data.coverAlt ?? post.data.title}
              widths={[400, 800]}
              sizes="(min-width: 768px) 400px, 100vw"
              format="webp"
            />
          )}
          <span class="eyebrow">{formatShortDate(post.data.publishDate)}</span>
          <h3>{post.data.title}</h3>
          <p>{post.data.description}</p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    padding: var(--space-3xl) 0 var(--space-2xl);
    max-width: 42rem;
  }
  .hero h1 {
    font-size: clamp(2rem, 4vw, 2.9rem);
    line-height: 1.15;
    margin: var(--space-sm) 0 var(--space-lg);
  }
  .hero__lede {
    color: var(--ink-muted);
    font-size: 1.05rem;
    max-width: 36rem;
  }
  .hero__image {
    display: block;
    width: 100%;
    height: auto;
    max-height: 22rem;
    object-fit: cover;
    border-radius: var(--radius);
    margin-top: var(--space-xl);
  }
  .hero__specs {
    display: flex;
    gap: var(--space-xl);
    margin-top: var(--space-xl);
    padding-top: var(--space-lg);
    border-top: 1px solid var(--line);
  }
  .hero__specs strong {
    display: block;
    margin-top: var(--space-xs);
    font-family: var(--font-mono);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--ink);
  }

  .section {
    padding: var(--space-xl) 0;
  }
  .section__title {
    font-size: 1.6rem;
    margin: var(--space-xs) 0 var(--space-lg);
  }
  .answer-grid {
    display: grid;
    gap: var(--space-md);
  }
  .see-all {
    display: inline-block;
    margin-top: var(--space-lg);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .post-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr));
    gap: var(--space-lg);
  }
  .post-card {
    display: block;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: var(--space-lg);
    text-decoration: none;
  }
  .post-card__thumb {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
    margin-bottom: var(--space-sm);
  }
  .post-card h3 {
    color: var(--ink);
    font-size: 1.1rem;
    margin: var(--space-xs) 0 var(--space-xs);
  }
  .post-card p {
    color: var(--ink-muted);
    font-size: 0.9rem;
    margin: 0;
  }
</style>
